# Copy this file to backend/.env and fill in the values. Never commit backend/.env.
# Variables are checked at startup in backend/src/config/env.validation.ts.

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=

# Authentication (ACC-04, ACC-06, ACC-19)
# Use two different long random strings. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Minutes an access token stays valid
ACCESS_TOKEN_MINUTES=10
# Minutes without an authenticated request before the session expires (ACC-06)
SESSION_INACTIVITY_MINUTES=30
# Cookies (ACC-19). Chrome, Edge and Firefox accept Secure cookies on http://localhost.
# Safari does not: if you use Safari, set COOKIE_SECURE=false in your own backend/.env.
COOKIE_SECURE=true
# lax is right while the frontend and the API both run on localhost.
# Use none (with COOKIE_SECURE=true) only if they are on different domains.
COOKIE_SAME_SITE=lax

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Exchange rates
FXRATES_API_KEY=

# Seeded admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
