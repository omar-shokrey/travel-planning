# Copy this file to backend/.env and fill in the values. Never commit backend/.env.
# Variables are checked at startup in backend/src/config/env.validation.ts.

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Uploaded images (GEN-08). Folder relative to backend/. Its contents are git-ignored.
UPLOADS_DIR=uploads

# Database
MONGODB_URI=

# Authentication (ACC-04, ACC-06, ACC-19)
# Use two different long random strings. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Minutes an access token stays valid
ACCESS_TOKEN_MINUTES=10
# Minutes without an authenticated request before the session expires (ACC-06)
SESSION_INACTIVITY_MINUTES=30
# Cookies (ACC-19). Chrome, Edge and Firefox accept Secure cookies on http://localhost.
# Safari does not: if you use Safari, set COOKIE_SECURE=false in your own backend/.env.
COOKIE_SECURE=true
# lax is right while the frontend and the API both run on localhost.
# Use none (with COOKIE_SECURE=true) only if they are on different domains.
COOKIE_SAME_SITE=lax

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Exchange rates (ITN-18). With no key the app uses the rates already cached.
FXRATES_API_KEY=
FXRATES_API_URL=https://api.fxratesapi.com

# Email notifications (GEN-01-B). Leave SMTP_HOST empty to switch email off:
# the app then starts, sends nothing and nothing fails.
# In development use a local test inbox that catches every mail without
# sending it, for example Mailpit:
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# then SMTP_HOST=localhost, SMTP_PORT=1025 and the inbox is at http://localhost:8025
# SMTP_SECURE=true means TLS from the first byte (usually port 465).
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Travel Platform <no-reply@travel-platform.local>

# Seeded admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
